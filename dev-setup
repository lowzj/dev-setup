#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/common.sh
source "$ROOT_DIR/lib/common.sh"
bootstrap_local_tool_paths
# shellcheck source=lib/detect.sh
source "$ROOT_DIR/lib/detect.sh"
# shellcheck source=lib/pkg.sh
source "$ROOT_DIR/lib/pkg.sh"
# shellcheck source=lib/node.sh
source "$ROOT_DIR/lib/node.sh"
# shellcheck source=lib/registry.sh
source "$ROOT_DIR/lib/registry.sh"
registry_source_components "$ROOT_DIR/components"

show_help() {
  local component_usage=""

  component_usage="$(registry_component_usage)"
  cat <<HELP
Usage:
  ./dev-setup help
  ./dev-setup doctor
  ./dev-setup list components
  ./dev-setup apply all [--force] [--dry-run] [--verbose]
  ./dev-setup component <${component_usage}> [--force] [--dry-run] [--verbose]
  ./dev-setup install packages [--component <name>] [--dry-run] [--verbose]

Exit codes:
  0 success (warnings allowed)
  1 runtime failure
  2 invalid arguments or unknown command
HELP
}

ensure_macos_supported() {
  local platform="$1"

  if [[ "$platform" == "macos" ]]; then
    return 0
  fi

  log_error "Unsupported platform: ${platform}. This repository supports macOS only."
  return 1
}

parse_common_flags() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force)
        FORCE=1
        ;;
      --dry-run)
        DRY_RUN=1
        ;;
      --verbose)
        VERBOSE=1
        ;;
      *)
        log_error "Unknown option: $1"
        return 1
        ;;
    esac
    shift
  done
}

parse_install_flags() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --component)
        shift
        if [[ $# -eq 0 ]]; then
          log_error "--component requires a value"
          return 1
        fi
        INSTALL_COMPONENT="$1"
        ;;
      --dry-run)
        DRY_RUN=1
        ;;
      --verbose)
        VERBOSE=1
        ;;
      *)
        log_error "Unknown option for install packages: $1"
        return 1
        ;;
    esac
    shift
  done
}

with_detected_context() {
  local force="$1"
  local dry_run="$2"
  local verbose="$3"
  local callback="$4"
  shift 4

  local platform="unknown"
  local pkg_manager="none"
  local has_sudo=0
  local PLATFORM="$platform"
  local PKG_MANAGER="$pkg_manager"
  local HAS_SUDO="$has_sudo"

  detect_environment
  platform="$PLATFORM"
  pkg_manager="$PKG_MANAGER"
  has_sudo="$HAS_SUDO"

  ensure_macos_supported "$platform" || return 1

  "$callback" "$force" "$dry_run" "$verbose" "$platform" "$pkg_manager" "$has_sudo" "$@"
}

print_doctor() {
  local brew_bin="no"
  local xcode_clt="n/a"
  local brew_bootstrap_ready="n/a"
  local PLATFORM="unknown"
  local PKG_MANAGER="none"
  local HAS_SUDO=0

  detect_environment

  ensure_macos_supported "$PLATFORM" || return 1

  if find_brew_bin >/dev/null 2>&1; then
    brew_bin="$(find_brew_bin)"
  fi

  if [[ "$PLATFORM" == "macos" ]]; then
    xcode_clt="$(is_xcode_clt_available && echo yes || echo no)"
    if [[ "$xcode_clt" == "yes" ]] && command -v curl >/dev/null 2>&1; then
      brew_bootstrap_ready="yes"
    else
      brew_bootstrap_ready="no"
    fi
  fi

  cat <<DOCTOR
platform=$PLATFORM
pkg_manager=$PKG_MANAGER
brew=$(command -v brew >/dev/null 2>&1 && echo yes || echo no)
brew_bin=$brew_bin
xcode_clt=$xcode_clt
brew_bootstrap_ready=$brew_bootstrap_ready
DOCTOR
}

list_components() {
  local component=""
  local desc=""
  local deps=""

  for component in $(registry_components); do
    desc="$(registry_component_description "$component")"
    deps="$(registry_component_dependencies_csv "$component")"
    if [[ -n "$deps" ]]; then
      printf '%s: %s [deps: %s]\n' "$component" "$desc" "$deps"
    else
      printf '%s: %s\n' "$component" "$desc"
    fi
  done
}

apply_component() {
  local component="$1"
  local force="$2"
  local dry_run="$3"
  local verbose="$4"
  local ordered_components=""

  if ! registry_component_exists "$component"; then
    log_error "Unknown component: $component"
    return 2
  fi

  ordered_components="$(registry_resolve_components_order "$component")" || return 1

  if ! with_detected_context "$force" "$dry_run" "$verbose" _apply_components_in_order "$ordered_components"; then
    log_error "Component failed: $component"
    return 1
  fi
}

apply_all_components() {
  local force="$1"
  local dry_run="$2"
  local verbose="$3"
  local ordered_components=""

  ordered_components="$(registry_resolve_components_order $(registry_components))" || return 1
  with_detected_context "$force" "$dry_run" "$verbose" _apply_components_in_order "$ordered_components"
}

install_packages() {
  local install_component="$1"
  local dry_run="$2"
  local verbose="$3"

  if [[ -n "$install_component" ]] && ! registry_component_exists "$install_component"; then
    log_error "Unknown component: $install_component"
    return 2
  fi

  with_detected_context 0 "$dry_run" "$verbose" _install_packages_impl "$install_component"
}

_install_packages_impl() {
  local _force="$1"
  local dry_run="$2"
  local verbose="$3"
  local platform="$4"
  local pkg_manager="$5"
  local has_sudo="$6"
  local install_component="$7"
  local package_specs=""
  local component=""
  local ordered_components=""

  if [[ -n "$install_component" ]]; then
    ordered_components="$(registry_resolve_components_order "$install_component")" || return 1
  else
    ordered_components="$(registry_resolve_components_order $(registry_components))" || return 1
  fi

  for component in $ordered_components; do
    if [[ -n "$package_specs" ]]; then
      package_specs="$package_specs"$'\n'
    fi
    package_specs="$package_specs$(registry_component_package_specs "$component" "$platform" "$pkg_manager")"
  done

  package_specs="$(printf '%s\n' "$package_specs" | pkg_specs_dedup)"
  if [[ -z "$package_specs" ]]; then
    log_info "No packages to install"
    return 0
  fi

  pkg_install_specs_text "$platform" pkg_manager "$has_sudo" "$dry_run" "$verbose" "$package_specs"
}

_apply_components_in_order() {
  local force="$1"
  local dry_run="$2"
  local verbose="$3"
  local platform="$4"
  local pkg_manager="$5"
  local has_sudo="$6"
  local ordered_components="$7"
  local component=""

  for component in $ordered_components; do
    if ! registry_component_apply "$component" "$force" "$dry_run" "$verbose" "$platform" pkg_manager "$has_sudo"; then
      log_error "Component failed: $component"
      return 1
    fi
  done
}

main() {
  local command="${1:-help}"
  local FORCE=0
  local DRY_RUN=0
  local VERBOSE=0
  local INSTALL_COMPONENT=""
  shift || true

  case "$command" in
    help|-h|--help)
      show_help
      ;;
    doctor)
      if ! parse_common_flags "$@"; then
        return 2
      fi
      print_doctor
      ;;
    list)
      if [[ "${1:-}" != "components" ]]; then
        log_error "Usage: ./dev-setup list components"
        return 2
      fi
      shift
      if [[ $# -ne 0 ]]; then
        log_error "Usage: ./dev-setup list components"
        return 2
      fi
      list_components
      ;;
    apply)
      if [[ "${1:-}" != "all" ]]; then
        log_error "Usage: ./dev-setup apply all [--force] [--dry-run] [--verbose]"
        return 2
      fi
      shift
      if ! parse_common_flags "$@"; then
        return 2
      fi
      apply_all_components "$FORCE" "$DRY_RUN" "$VERBOSE"
      ;;
    component)
      if [[ $# -eq 0 ]]; then
        log_error "Usage: ./dev-setup component <name> [--force] [--dry-run] [--verbose]"
        return 2
      fi
      local component="$1"
      shift
      if ! parse_common_flags "$@"; then
        return 2
      fi
      apply_component "$component" "$FORCE" "$DRY_RUN" "$VERBOSE"
      ;;
    install)
      if [[ "${1:-}" != "packages" ]]; then
        log_error "Usage: ./dev-setup install packages [--component <name>] [--dry-run] [--verbose]"
        return 2
      fi
      shift
      if ! parse_install_flags "$@"; then
        return 2
      fi
      install_packages "$INSTALL_COMPONENT" "$DRY_RUN" "$VERBOSE"
      ;;
    *)
      log_error "Unknown command: $command"
      return 2
      ;;
  esac
}

main "$@"
